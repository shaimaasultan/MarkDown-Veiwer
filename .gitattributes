# Line endings are fixed per file type, so a checkout or pull never rewrites a file on disk (which would
# make Check-Source.cmd report it as changed). Scripts use CRLF, as Windows PowerShell and cmd expect.
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.cs text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.js text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
# The page and the bundled libraries are kept byte for byte (they are packed into the signed Content DLL).
src/** -text
*.dll binary
*.png binary
*.mp4 binary
*.woff binary
*.woff2 binary
*.ttf binary
# Saved as UTF-16 on purpose (encoding test): never convert.
test/utf16.md -text
# Table test data, kept byte for byte.
test/*.csv -text
test/*.json -text
test/*.jsonl -text
*.xlsx binary
test/*.log -text
test/*.ps1 -text
test/*.yaml -text
test/*.xml -text
test/*.ipynb -text
